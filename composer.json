{
    "name": "roelvanhintum/craft-assetusage",
    "description": "Adds a column to see which assets are used or unused.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "asset usage"
    ],
    "support": {
        "docs": "https://github.com/roelvanhintum/craft-assetusage/blob/craft4/README.md",
        "issues": "https://github.com/roelvanhintum/craft-assetusage/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Roel van Hintum",
            "homepage": "https://roel.vanhintum.eu/"
        },
        {
            "name": "Born05",
            "homepage": "https://www.born05.com/"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "craftcms/cms": "^5.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "verbb/hyper": "^2.0.0"
    },
    "scripts": {
        "phpstan": "phpstan --ansi --memory-limit=1G",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi"
    },
    "autoload": {
        "psr-4": {
            "roelvanhintum\\assetusage\\": "src/"
        }
    },
    "extra": {
        "name": "Asset Usage",
        "handle": "assetusage",
        "hasCpSettings": false,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/roelvanhintum/craft-assetusage/craft4/CHANGELOG.md"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
