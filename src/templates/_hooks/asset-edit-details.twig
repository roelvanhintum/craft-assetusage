<h3>{{'Used in'|t('assetusage')}}</h3>

<div class="elementselect">
	<div class="elements">
		{% for element in elements %}
			<a href="{{ element.cpEditUrl }}" class="chip small element">
				<div class="chip-content">
					<span class="status {{ element.status }}" role="img" aria-label="Status: {{ element.status }}"></span>
					<div class="label">
						<span class="label-link">{{element.title}}</span>
					</div>
				</div>
			</a>
		{% endfor %}
	</div>
</div>
